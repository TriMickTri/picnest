<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PicNest.PreferencesWindow"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Title="PicNest preferences">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppPageBackgroundBrush}">
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="Preferences" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="These settings stay on this PC and never affect your original photos or videos."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Margin="24,18">
      <StackPanel Spacing="16">
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Choose the look PicNest uses when it starts." Classes="muted" />
            <StackPanel Orientation="Horizontal" Spacing="22" Margin="2,2,0,0">
              <RadioButton Name="LightTheme" Content="Light mode" GroupName="Theme" />
              <RadioButton Name="DarkTheme" Content="Dark mode" GroupName="Theme" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Slideshow" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="These settings are used when you start a slideshow from any library view, folder, Favorites, or album."
                       Classes="muted" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
              <TextBlock Text="Time per slide" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Name="SlideDuration" Minimum="0.5" Maximum="60" Increment="0.5"
                             Value="3" Width="140" />
              <TextBlock Grid.Column="2" Text="seconds (0.5-second increments)" Classes="muted" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
              <TextBlock Text="Transition" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Name="TransitionStyle" SelectedIndex="2" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="Fade" />
                <ComboBoxItem Content="Swipe" />
                <ComboBoxItem Content="Mix" />
              </ComboBox>
            </Grid>
            <CheckBox Name="IncludeSlideshowVideos" Content="Include videos in slideshows" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Storage" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="These folders contain PicNest-created files only: diagnostics and thumbnail cache files."
                       Classes="muted" TextWrapping="Wrap" />

            <TextBlock Text="Diagnostic log location" FontWeight="SemiBold" Margin="0,5,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Name="DiagnosticPath" Watermark="Choose a folder for picnest.log" />
              <Button Grid.Column="1" Click="BrowseDiagnostics" Content="Browse..." MinWidth="90" />
            </Grid>
            <TextBlock Text="New entries are written to picnest.log in this folder." Classes="muted" FontSize="12" />

            <TextBlock Text="Thumbnail cache location" FontWeight="SemiBold" Margin="0,7,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Name="ThumbnailPath" Watermark="Choose a folder for generated thumbnails" />
              <Button Grid.Column="1" Click="BrowseThumbnails" Content="Browse..." MinWidth="90" />
            </Grid>
            <TextBlock Text="After changing this location, use Refresh folders to rebuild cached thumbnails there."
                       Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Name="DialogStatus" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Click="ResetDefaults" Content="Restore defaults" />
        <Button Grid.Column="2" Click="Cancel" Content="Cancel" />
        <Button Grid.Column="3" Classes="brand-button" Click="Save" Padding="0" BorderThickness="0">
          <Border Background="#167397" BorderBrush="#0F6382" BorderThickness="1" CornerRadius="4" Padding="15,6">
            <TextBlock Text="Save changes" Foreground="White" FontWeight="SemiBold" />
          </Border>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
