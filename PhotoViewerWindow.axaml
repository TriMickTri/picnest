<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        x:Class="PicNest.PhotoViewerWindow"
        Width="1280"
        Height="860"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#1B2225">
  <Grid RowDefinitions="64,*,58,34">
    <Border Background="#26333A" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Spacing="2">
          <TextBlock Name="PhotoName" Foreground="White" FontSize="16" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Name="PhotoDetails" Foreground="#B9C6C9" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Name="PreviousButton" Click="PreviousPhoto" Content="Previous" />
          <Button Name="NextButton" Click="NextPhoto" Content="Next" />
          <Border Background="#1B2225" CornerRadius="3" Padding="9,5">
            <TextBlock Name="PositionText" Foreground="#D9E2E3" FontSize="11" />
          </Border>
          <Button Name="PlayPauseButton" Click="TogglePlayback" Content="Pause" IsVisible="False" />
          <Button Name="ZoomOutButton" Click="ZoomOut" Content="-" Width="32" />
          <Border Background="#1B2225" CornerRadius="3" Padding="9,5">
            <TextBlock Name="ZoomText" Foreground="#D9E2E3" FontSize="11" />
          </Border>
          <Button Name="ZoomInButton" Click="ZoomIn" Content="+" Width="32" />
          <Button Name="ResetViewButton" Click="ResetView" Content="Reset view" />
          <Button Click="CloseViewer" Content="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#111719">
      <Grid>
        <ScrollViewer Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ViewerViewportChanged">
          <Grid Name="ImageHost" Background="#111719">
            <!-- This is the original image, not the PicNest thumbnail cache. -->
            <Image Name="PhotoImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border Name="LoadError" IsVisible="False" Background="#26333A" CornerRadius="5"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Name="LoadErrorText" Foreground="White" TextWrapping="Wrap" MaxWidth="520" />
            </Border>
          </Grid>
        </ScrollViewer>
        <vlc:VideoView Name="VideoView" IsVisible="False" />
      </Grid>
    </Border>

    <Border Name="VideoControls" Grid.Row="2" IsVisible="False" Background="#202A2E" Padding="20,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,110,Auto" ColumnSpacing="10" VerticalAlignment="Center">
        <Button Name="StopVideoButton" Click="StopVideo" Content="Stop" />
        <TextBlock Grid.Column="1" Name="VideoTimeText" Foreground="#D9E2E3" FontSize="11"
                   VerticalAlignment="Center" Text="0:00 / 0:00" />
        <Slider Grid.Column="2" Name="VideoPositionSlider" Minimum="0" Maximum="1" Value="0"
                ValueChanged="VideoPositionChanged" VerticalAlignment="Center" />
        <Button Grid.Column="3" Name="MuteButton" Click="ToggleMute" Content="Mute" />
        <TextBlock Grid.Column="4" Foreground="#B9C6C9" FontSize="11" VerticalAlignment="Center" Text="Volume" />
        <Slider Grid.Column="5" Name="VolumeSlider" Minimum="0" Maximum="100" Value="100"
                ValueChanged="VolumeChanged" VerticalAlignment="Center" />
        <Button Grid.Column="6" Click="CloseViewer" Content="Close viewer" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#26333A" Padding="20,0">
      <TextBlock Name="SourcePath" Foreground="#B9C6C9" FontSize="11"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
