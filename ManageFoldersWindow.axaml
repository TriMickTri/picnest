<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PicNest.Models"
        x:Class="PicNest.ManageFoldersWindow"
        Width="700"
        Height="470"
        MinWidth="560"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Title="Manage imported folders">
  <Grid RowDefinitions="Auto,*,Auto" Background="#F8FAFA">
    <Border Background="White" BorderBrush="#D5DEDF" BorderThickness="0,0,0,1" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="Manage imported folders" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="PicNest reads these folders but never moves, edits, or deletes your original files."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="24,18" Background="White" BorderBrush="#D5DEDF"
            BorderThickness="1" CornerRadius="5" Padding="8">
      <ListBox Name="FolderList" ItemsSource="{Binding ImportedFolders}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:LibraryRoot">
            <StackPanel Margin="10,8" Spacing="3">
              <TextBlock Text="{Binding DisplayName}" Foreground="#26333A" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Path}" Foreground="#738287" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="2" Background="White" BorderBrush="#D5DEDF" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Name="DialogStatus" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Classes="brand-button" Click="AddFolder" Padding="0" BorderThickness="0" Margin="0,0,8,0">
          <Border Background="#167397" CornerRadius="4" Padding="12,6">
            <TextBlock Text="+ Add folder" Foreground="White" FontWeight="SemiBold" />
          </Border>
        </Button>
        <Button Grid.Column="2" Classes="brand-button" Click="RemoveFolder" Padding="0" BorderThickness="0" Margin="0,0,8,0">
          <Border Background="#8B4340" CornerRadius="4" Padding="12,6">
            <TextBlock Text="Remove selected" Foreground="White" FontWeight="SemiBold" />
          </Border>
        </Button>
        <Button Grid.Column="3" Click="CloseDialog" Content="Done" Padding="14,6" />
      </Grid>
    </Border>
  </Grid>
</Window>
