<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PicNest.Models"
        x:Class="PicNest.ManageAlbumsWindow"
        Width="700"
        Height="500"
        MinWidth="560"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        Title="Manage albums">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppPageBackgroundBrush}">
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="Albums" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Name="SelectionHint" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="24,18,24,0" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Name="AlbumName" Watermark="New album name, for example Trip to Italy" />
        <Button Grid.Column="1" Classes="brand-button" Click="CreateAlbum" Padding="0" BorderThickness="0">
          <Border Background="#167397" BorderBrush="#0F6382" BorderThickness="1" CornerRadius="4" Padding="14,6">
            <TextBlock Text="Create album" Foreground="White" FontWeight="SemiBold" />
          </Border>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="24,18" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
      <ListBox Name="AlbumList" ItemsSource="{Binding Albums}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:Album">
            <Grid Margin="10,8" ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <Border Grid.Column="1" Background="{DynamicResource AppBadgeBrush}" CornerRadius="8" Padding="7,1" Margin="10,0,0,0">
                <TextBlock Text="{Binding PhotoCount}" Foreground="{DynamicResource AppBadgeTextBrush}" FontSize="10" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Name="DialogStatus" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Click="AddSelection" Content="Add selection" Margin="0,0,8,0" />
        <Button Grid.Column="2" Click="RemoveAlbum" Content="Remove album" Margin="0,0,8,0" />
        <Button Grid.Column="3" Click="CloseDialog" Content="Done" Padding="14,6" />
      </Grid>
    </Border>
  </Grid>
</Window>
