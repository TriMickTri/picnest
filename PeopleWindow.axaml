<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PicNest.Models"
        x:Class="PicNest.PeopleWindow"
        Width="760"
        Height="600"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Title="People">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource AppPageBackgroundBrush}">
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,18">
      <StackPanel Spacing="4">
        <TextBlock Text="People" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="PicNest groups similar faces locally. Name a group once and its people album stays on this PC."
                   Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="24,18,24,0" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
        <TextBlock Text="Name selected group" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Name="PersonName" Watermark="For example, Mick" />
        <Button Grid.Column="2" Click="SaveName" Content="Save name" />
        <Button Grid.Column="3" Click="ViewPerson" Content="View album" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="24,18" Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
      <ListBox Name="PeopleList" ItemsSource="{Binding People}" SelectionChanged="PersonSelected">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="models:FacePerson">
            <Grid Margin="9,7" ColumnDefinitions="72,*,Auto" ColumnSpacing="11">
              <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" Background="{DynamicResource AppBadgeBrush}">
                <Image Source="{Binding RepresentativeFacePath}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
              </StackPanel>
              <Button Grid.Column="2" Content="Open" VerticalAlignment="Center" Click="ViewPerson" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Name="DialogStatus" Classes="muted" TextWrapping="Wrap" />
          <ProgressBar Name="ScanProgress" Minimum="0" Maximum="1" Height="5" IsVisible="False" />
        </StackPanel>
        <Button Grid.Column="1" Name="ScanButton" Click="ScanAllPictures" Content="Scan all pictures" Padding="14,6" />
        <Button Grid.Column="2" Click="CloseDialog" Content="Done" Padding="14,6" />
      </Grid>
    </Border>
  </Grid>
</Window>
