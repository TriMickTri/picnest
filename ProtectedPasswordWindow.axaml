<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PicNest.ProtectedPasswordWindow"
        Width="440"
        Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Protected folders">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppPageBackgroundBrush}">
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1" Padding="22,16">
      <StackPanel Spacing="4">
        <TextBlock Name="Heading" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Name="Description" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="22,18" Spacing="9">
      <TextBlock Name="PasswordLabel" Text="Password" FontWeight="SemiBold" />
      <TextBox Name="PasswordInput" PasswordChar="●" />
      <StackPanel Name="ConfirmationPanel" Spacing="9">
        <TextBlock Text="Confirm password" FontWeight="SemiBold" />
        <TextBox Name="ConfirmationInput" PasswordChar="●" />
      </StackPanel>
      <TextBlock Name="DialogStatus" Foreground="#9E4039" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,1,0,0" Padding="22,13">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Click="Cancel" Content="Cancel" />
        <Button Name="SubmitButton" Click="Submit" Content="Unlock" Padding="14,6" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
